# ============================================================================
# Keiko — modello delle variabili d'ambiente.
# Copia questo file in `.env.local` e riempi i valori veri. I valori qui sotto
# sono finti: servono a far vedere la forma, non funzionano.
# `.env.local` NON entra nel repo (lo esclude .gitignore); questo file sì.
# ============================================================================

# ---------------------------------------------------------------------------
# OBBLIGATORIE — senza queste l'app non parte o non legge i dati
# ---------------------------------------------------------------------------

# Accesso con Google (NextAuth). AUTH_SECRET firma il cookie di sessione:
# generane uno con `npx auth secret`. AUTH_URL è l'indirizzo dell'app.
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
AUTH_GOOGLE_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
AUTH_URL=http://localhost:3000

# Supabase — il database. L'URL e la chiave `anon` sono pubblici (finiscono nel
# browser); la `service_role` scavalca ogni permesso e NON deve mai uscire dal
# server: se la perdi, cambiala subito dal pannello Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.finta.finta
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.finta.finta

# Firma i token con cui l'app interroga il database "come utente", così le
# regole di privacy (RLS) sanno chi sta chiedendo. Sta in Supabase, sotto
# Settings → API → JWT Secret. Senza, nessuno legge i propri dati.
SUPABASE_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ L'INTERRUTTORE DELLA PRIVACY. L'unico valore accettato è "1".
# Se manca (o vale altro) l'app NON ripiega in silenzio su "tutti vedono tutto":
# stampa un banner all'avvio e ogni lettura e scrittura fallisce. È voluto —
# un ripiego silenzioso ha già fatto sparire i dati di una persona una volta.
# Va impostata anche su Vercel, in TUTTI e tre gli ambienti.
MULTIUSER_RLS=1

# Il modello che legge screenshot, PDF e frasi libere.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# TETTO DI SPESA AI (K6) — facoltative: senza, valgono i default
# ---------------------------------------------------------------------------

# Operazioni al giorno per persona. Non pesano uguale: una cattura vale 1, un
# piano 5, un viaggio 10. Finite, Keiko non chiama il modello e lo dice con
# garbo. Default: 30.
AI_CAP_PER_DAY=30

# Rete di sicurezza del cron: non blocca mai una persona, serve solo a fermare
# un ciclo impazzito. Default: 300.
AI_CAP_CRON_PER_DAY=300

# ---------------------------------------------------------------------------
# NOTIFICHE PUSH — servono perché i promemoria partano davvero
# ---------------------------------------------------------------------------

# Coppia di chiavi VAPID: generale con `npx web-push generate-vapid-keys`.
# La pubblica finisce nel browser, la privata resta sul server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Un recapito con cui il servizio push può avvisarti se qualcosa va storto.
VAPID_SUBJECT=mailto:tu@esempio.it

# Parola d'ordine dei lavori automatici (/api/cron/*). Le rotte del cron girano
# senza login: è questa a impedire che le lanci un estraneo.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# INDIRIZZO DEL SITO — facoltativa
# ---------------------------------------------------------------------------

# Serve all'anteprima dei link (WhatsApp, Telegram): l'immagine vuole un
# indirizzo assoluto. Se non la imposti, in produzione l'app usa il dominio che
# le dà Vercel, e in locale localhost. Mettila se hai un dominio tuo.
# NEXT_PUBLIC_SITE_URL=https://keiko.esempio.it

# ---------------------------------------------------------------------------
# SERVIZI ESTERNI — tutte facoltative.
# Senza, la funzione corrispondente non si rompe: resta spenta o usa un ripiego.
# ---------------------------------------------------------------------------

# Locandine e dati di film e serie (sezione Guarda).
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Foto dei luoghi nelle card degli eventi. ⚠️ Si paga a chiamata.
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Immagini di riserva per città e categorie, quando non c'è una foto migliore.
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Foto dei piatti nel piano alimentare.
SPOONACULAR_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Copertine per concerti e artisti.
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Squadre e loghi per gli eventi sportivi.
THESPORTSDB_KEY=123456

# ---------------------------------------------------------------------------
# EREDITÀ — servono solo alla migrazione dei dati vecchi, non all'app di oggi
# ---------------------------------------------------------------------------

# Airtable: da dove arrivavano gli eventi prima di Supabase. Le usa solo
# scripts/migrate-airtable-to-supabase.ts.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Eventi

# Webhook di Make (automazioni vecchie), usato da /api/refresh.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxxxxxxxx
MAKE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Non le scrivi tu: NODE_ENV, NEXT_RUNTIME, VERCEL_GIT_COMMIT_SHA e
# VERCEL_PROJECT_PRODUCTION_URL le mettono Next e Vercel da soli.
# ============================================================================

# Ricerca ricette della sezione Cucina (docs/SPEC-CUCINA.md).
# Tavily: un valore solo, si prende in due minuti su app.tavily.com
# (vedi docs/CHIAVI-API.md). La chiave comincia per "tvly-".
# Ha preso il posto di Google Custom Search, che il 7 agosto 2026 e' stato
# chiuso ai nuovi clienti: se trovi ancora GOOGLE_CSE_KEY / GOOGLE_CSE_CX nel
# tuo .env.local, puoi cancellarle -- il codice non le guarda piu'.
TAVILY_API_KEY=

# Ripiego: Brave Search. Da agosto 2026 non ha piu' un piano gratuito, quindi
# di norma resta vuota. Si usa solo se Tavily manca.
BRAVE_SEARCH_KEY=

# Senza nessuna delle due, la sezione Cucina resta intera: dice che la ricerca
# arriva presto, e il ricettario salvato funziona lo stesso.

# ============================================================================
# SOLO SVILUPPO — non metterla mai su Vercel
# ============================================================================

# Entra nell'app in locale senza passare da Google, pagine E rotte api.
# Il valore e' l'email con cui entri: da quella si ricava la chiave utente.
# Serve a provare le ondate di lavoro sull'app vera invece che su banchi finti.
#
# METTI L'INDIRIZZO DI PROVA, non il tuo. Con `prova@keiko.local` hai un utente
# tutto tuo, vuoto, dove puoi premere qualsiasi cosa. Con l'indirizzo vero ogni
# tasto premuto scrive nello storico vero -- serie finte nell'allenamento,
# spunte sulla lista della spesa -- e corrompe i dati su cui si lavora.
# L'indirizzo vero si usa SOLO PER GUARDARE, mai per premere. Vedi AGENTS.md.
#
# Due serrature in AND (lib/dev-login.ts): la variabile deve esserci, E
# NODE_ENV non dev'essere "production" -- cosi' anche finita per sbaglio in
# produzione non fa niente. Lasciala vuota se non ti serve.
KEIKO_DEV_LOGIN=prova@keiko.local
