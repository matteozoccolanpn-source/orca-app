# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...tranne il template senza segreti: quello deve stare nel repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefatti tool di verifica (screenshot MCP)
.playwright-mcp/
.claude/

# il banco di lavoro: screenshot di verifica, prove, appunti. Serve a chi
# lavora, non al repo.
scratchpad/

# documenti di prova veri (nomi, telefoni, PNR reali): mai nel repo, mai nei
# messaggi di commit. Vedi AGENTS.md.
docs/prove/

# il cestino di sessione: ci finisce quello che sta per sparire. Non deve mai
# entrare nel repo, nemmeno per sbaglio.
_to_delete/
